let notes = [5, 2, -8, 0, -3]

d1
  $ (|+ note 26.3)
  $ sometimes (jux (|+ note 0.07))
  $ sometimes (jux (|+ note (-12)))
  $ sometimes (jux (|+ note (-5)))
  $ sometimes (jux (|+ note 7))
  $ sometimes (jux (|+ note 7))
  $ rarely (superimpose (# note (choose [5, 2, -8, 0, -3])))
  $ segment 16
  $ note "f4 ~ c4 d4 . f3 g4 ~ ~ . f4 d3 g4 c4"
  # s "psin"
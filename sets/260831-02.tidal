setcps 0.6





d2 $ jux rev $ mask "[0 [0 1]]/2" $ almostAlways (# speed (range 0.1 4.5 sine)) 
   $ loopAt "0.5 0.1" 
   $ striate "40" 
   $ s "em2:5*9"
   # gain 1.3
   # unit "c"



d1 $ jux (# speed (fast saw $ range 2.5 20.5 saw)) 
  $ mask "[1 0]/2" 
   $ loopAt "0.5 4 0.25"
   $ striate "22 10" 
   $ s "simplesine*3*<9 30>" 
   # unit "c"
   # disperser 0.356
   # gain 1.1
   


d3 $ loopAt 2 $ s "[east:4!3,] ~" # smear 0.09  


d6 $ silence

d6
  
  $ mask "[1 0]/2" 
  $ (|+ note 46)
  $ (|+ note 0.3)
  $ sometimes (jux (|+ note 0.07))
  $ sometimes (jux (|+ note (-12)))
  $ sometimes (jux (|+ note (-5)))
  $ sometimes (jux (|+ note 7))
  $ rarely (superimpose (# note (choose [5, 2, -8, 0, -3])))
  $ segment 16
  $ note "f4 ~ c4  . f3 g4 ~ ~ . f4*2 d3*5  "
  # s "strudelSine*4"
  # fm 0
  # sineAttack 0.2
  # sineDecay 0.1
  # sineRelease 0.8
  # gain 0.8







-- toy factory (^ ^)


d6
  $ (|+ note 13)
  -- $ (|+ note 36)
  -- $ (|+ note 0.3)
  $ sometimes (jux (|+ note 0.07))
  $ sometimes (jux (|+ note (-12)))
  $ sometimes (jux (|+ note (-5)))
  $ sometimes (jux (|+ note 7))
  $ rarely (superimpose (# note (choose [5, 2, -8, 0, -3])))
  $ segment 16
  $ note "f4 ~ c4 d4 . f3 g4 ~ ~ . f4 d3 g4 c4"
  # s "strudelSine"
  # fm 0.1
  # sineAttack 0.2
  # sineDecay 0.1
  # sineRelease 0.8
  # gain 0.7
  # tinySmear 0.9

d2 $ s "<tink:4 tink:3>"
  # tinySmear 0.8
  # pan (range 0 1 $ slow 4 sine)
  # gain 2.0
  # speed 0.5
  # legato 0.5

d1 $ sound "toys:5 <toys:8 _ newnotes:5*9 toys:7 toys:4>"
  # disperser 0.4
  # disperserFreq 500.0
  # pan (range 0 1 $ slow 4 sine)
  # speed "1.6 0.75"
  # gain 1.2


d5 $ swing 4 $ s "industrial:12* <4 <4 [4 2 [24 8]]>>" # gain 1.3


d3 $ s "[808:8(6,8), future:1(7,16)], bin:2(5,8,2)"
  # gain 1.4

d4 $ s "<hmm _ _>" 
   # speed "<1.7 1.9 3>/2.5"
   # pan (range 0 1 $ slow 4 sine)
   # gain 1.3

d1 $ jux (# speed (fast saw 
   $ range 2.5 20.5 saw)) 
  $ mask "[1 0]/2" 
   $ loopAt "0.1 4 0.25"
   $ striate "22 10" 
   $ s "simplesine*<9 30>" 
   # unit "c"
   # gain 0.9




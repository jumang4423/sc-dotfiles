// bass test


hush

d1 $ sound "toys:9"
  # disperser 0.9
  # disperserFreq 400.0
  # tinySmear 0.9
  # pan (range 0 1 $ slow 4 sine)

d5 $ s "hand:7 * 3"
  # disperser 0.2
  # tinySmear 0.2
  # pan (range 0 1 $ slow 4 sine)

d6 $ s "bin perc" <| n (run "<4 18>")
  # disperser 0.3
  # tinySmear 0.6
  # pan (range 0 1 $ slow 4 sine)

